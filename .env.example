SECRET_KEY=change-me
DEBUG=True

# Email OTP delivery
# In DEBUG, real email is sent only when these SMTP settings are present.
# Otherwise OTP emails are printed in the runserver console.
# Use EMAIL_DELIVERY_MODE=console only when you want OTPs printed locally.
# Use EMAIL_DELIVERY_MODE=custom only if you also set EMAIL_BACKEND manually.
EMAIL_DELIVERY_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=DevLog <your-email@example.com>

# SMS OTP delivery through Twilio. Phone numbers must be in E.164 format.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Optional Redis/Celery worker mode. Leave USE_REDIS=False for local sync OTP sending.
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True
