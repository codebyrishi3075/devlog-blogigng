{
  "info": {
    "_postman_id": "2b8f92a1-1b2d-4e74-b456-23f31eb6975b",
    "name": "DevLog API",
    "description": "Corrected Postman Collection v2.1 for the DevLog Django REST Framework accounts API. URLs are based on accounts/urls.py and request/response examples are based on accounts/api_views.py and accounts/serializers.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Core Auth",
      "description": "Core registration, login, profile, and token refresh endpoints.",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"TestPass123!\",\n  \"password2\": \"TestPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a user with username, email, password, and password2. The current RegisterSerializer expects password and password2, and returns JWT tokens immediately."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"username\": \"testuser\",\n    \"name\": \"Test User\",\n    \"email\": \"testuser@example.com\",\n    \"phone_number\": null,\n    \"date_of_birth\": null,\n    \"gender\": \"N\",\n    \"bio\": \"\",\n    \"profile_picture\": null,\n    \"is_email_verified\": false,\n    \"is_phone_verified\": false,\n    \"is_verified\": false\n  },\n  \"refresh\": \"example.refresh.token\",\n  \"access\": \"example.access.token\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"access_token\", json.access);",
                  "pm.environment.set(\"refresh_token\", json.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"TestPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates a verified user with username and password. The Tests script saves access_token and refresh_token into the active environment."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"username\": \"testuser\",\n    \"name\": \"Test User\",\n    \"email\": \"testuser@example.com\",\n    \"phone_number\": \"+919876543210\",\n    \"date_of_birth\": \"2000-01-15\",\n    \"gender\": \"N\",\n    \"bio\": \"\",\n    \"profile_picture\": null,\n    \"is_email_verified\": true,\n    \"is_phone_verified\": false,\n    \"is_verified\": true\n  },\n  \"refresh\": \"example.refresh.token\",\n  \"access\": \"example.access.token\"\n}"
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Returns the authenticated user's serialized profile. Requires Authorization: Bearer {{access_token}}."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 1,\n  \"username\": \"testuser\",\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone_number\": \"+919876543210\",\n  \"date_of_birth\": \"2000-01-15\",\n  \"gender\": \"N\",\n  \"bio\": \"\",\n  \"profile_picture\": null,\n  \"is_email_verified\": true,\n  \"is_phone_verified\": false,\n  \"is_verified\": true\n}"
            }
          ]
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token refresh succeeded\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.environment.set(\"access_token\", json.access);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "token",
                "refresh"
              ]
            },
            "description": "Uses the saved refresh token to request a new access token. The Tests script saves the returned access token into access_token."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access\": \"example.new.access.token\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Unified Registration",
      "description": "Two-step registration flow that creates an unverified account and verifies email or phone OTP before issuing JWT tokens.",
      "item": [
        {
          "name": "Start Unified Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"unifieduser\",\n  \"password\": \"TestPass123!\",\n  \"name\": \"Unified User\",\n  \"date_of_birth\": \"2000-01-15\",\n  \"gender\": \"N\",\n  \"email\": \"{{test_email}}\",\n  \"phone_number\": \"{{test_phone}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/unified/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "unified"
              ]
            },
            "description": "Creates an unverified account and sends REGISTER OTP to the provided email and/or phone number. At least one of email or phone_number is required."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"OTP sent to: email (testuser@example.com), SMS (+919876543210). Verify to activate your account.\",\n  \"user_id\": 2,\n  \"channels\": [\n    \"email (testuser@example.com)\",\n    \"SMS (+919876543210)\"\n  ]\n}"
            }
          ]
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_code\": \"{{test_otp}}\",\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/verify/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "verify"
              ]
            },
            "description": "Verifies a REGISTER OTP for either email or phone_number, marks that channel as verified, and returns JWT tokens."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Account verified successfully. Welcome to DevLog!\",\n  \"user\": {\n    \"id\": 2,\n    \"username\": \"unifieduser\",\n    \"name\": \"Unified User\",\n    \"email\": \"testuser@example.com\",\n    \"phone_number\": \"+919876543210\",\n    \"date_of_birth\": \"2000-01-15\",\n    \"gender\": \"N\",\n    \"bio\": \"\",\n    \"profile_picture\": null,\n    \"is_email_verified\": true,\n    \"is_phone_verified\": false,\n    \"is_verified\": true\n  },\n  \"refresh\": \"example.refresh.token\",\n  \"access\": \"example.access.token\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Mobile Registration",
      "description": "Phone-number registration flow using SMS OTP.",
      "item": [
        {
          "name": "Start Mobile Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mobileuser\",\n  \"phone_number\": \"{{test_phone}}\",\n  \"password\": \"TestPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/mobile/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "mobile"
              ]
            },
            "description": "Validates username and phone number, then sends a REGISTER OTP by SMS. The user is created only after OTP verification."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"OTP sent to +919876543210.\"\n}"
            }
          ]
        },
        {
          "name": "Verify Mobile Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"{{test_phone}}\",\n  \"otp_code\": \"{{test_otp}}\",\n  \"username\": \"mobileuser\",\n  \"password\": \"TestPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/mobile/verify/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "mobile",
                "verify"
              ]
            },
            "description": "Verifies the mobile REGISTER OTP, creates the user, marks the phone as verified, and returns JWT tokens."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Registration successful.\",\n  \"user\": {\n    \"id\": 3,\n    \"username\": \"mobileuser\",\n    \"name\": \"\",\n    \"email\": \"\",\n    \"phone_number\": \"+919876543210\",\n    \"date_of_birth\": null,\n    \"gender\": \"N\",\n    \"bio\": \"\",\n    \"profile_picture\": null,\n    \"is_email_verified\": false,\n    \"is_phone_verified\": true,\n    \"is_verified\": true\n  },\n  \"refresh\": \"example.refresh.token\",\n  \"access\": \"example.access.token\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Forgot Password",
      "description": "OTP-based password reset flow for email or phone number.",
      "item": [
        {
          "name": "Request Password Reset OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Requests a FORGOT_PASSWORD OTP for an email or phone_number. The response is intentionally generic to avoid account enumeration."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"If this account exists, an OTP has been sent.\"\n}"
            }
          ]
        },
        {
          "name": "Verify Password Reset OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp_code\": \"{{test_otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password/verify-otp/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password",
                "verify-otp"
              ]
            },
            "description": "Verifies a FORGOT_PASSWORD OTP for an email or phone_number. A successful verification allows the password reset request."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"OTP verified successfully.\"\n}"
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp_code\": \"{{test_otp}}\",\n  \"new_password\": \"NewPass123!\",\n  \"confirm_password\": \"NewPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password/reset/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password",
                "reset"
              ]
            },
            "description": "Resets a user's password using a verified FORGOT_PASSWORD OTP. Accepts either email or phone_number."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Password reset successful.\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "OTP Management",
      "description": "OTP resend endpoint for registration and forgot-password flows.",
      "item": [
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"REGISTER\",\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/otp/resend/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "otp",
                "resend"
              ]
            },
            "description": "Resends an OTP for purpose REGISTER or FORGOT_PASSWORD. Provide either email or phone_number."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"A new OTP has been sent.\"\n}"
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ]
}
